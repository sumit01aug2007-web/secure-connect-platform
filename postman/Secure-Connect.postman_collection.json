{
  "info": {
    "_postman_id": "b9e8b31c-6a2c-4a4b-9d2a-8f2e2c6d4a11",
    "name": "Secure Connect Platform - Lab 4",
    "description": "API tests for signup, login, protected routes, RBAC and Notes CRUD.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "token", "value": "" },
    { "key": "noteId", "value": "" },
    { "key": "testEmail", "value": "student.lab4@example.com" },
    { "key": "testPassword", "value": "StrongPass123" }
  ],
  "item": [
    {
      "name": "Health & Authentication",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Health check returns 200', () => pm.response.to.have.status(200));"] , "type": "text/javascript" } }]
        },
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"victor\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/signup"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Signup returns 201 or existing-user 409', () => pm.expect([201, 409]).to.include(pm.response.code));"] , "type": "text/javascript" } }]
        },
        {
          "name": "Login (saves token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login returns 200', () => pm.response.to.have.status(200));", "const data = pm.response.json();", "if (data.token) pm.collectionVariables.set('token', data.token);", "pm.test('JWT token is returned', () => pm.expect(data.token).to.be.a('string').and.not.empty);"] , "type": "text/javascript" } }]
        },
        {
          "name": "Protected Profile",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Profile returns 200', () => pm.response.to.have.status(200));"] , "type": "text/javascript" } }]
        },
        {
          "name": "Protected Profile - No Token (expected 401)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Missing token is rejected', () => pm.response.to.have.status(401));"] , "type": "text/javascript" } }]
        },
        {
          "name": "Admin Route - Regular User (expected 403)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/auth/admin" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Regular user is forbidden', () => pm.response.to.have.status(403));"] , "type": "text/javascript" } }]
        }
      ]
    },
    {
      "name": "Notes CRUD",
      "item": [
        {
          "name": "Create Note",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"My First Note\",\n  \"content\": \"This is my first secure note.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/notes" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Note is created', () => pm.response.to.have.status(201));", "const data = pm.response.json();", "if (data.note && data.note._id) pm.collectionVariables.set('noteId', data.note._id);"] , "type": "text/javascript" } }]
        },
        {
          "name": "Get All My Notes",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/notes" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Notes list returns 200', () => pm.response.to.have.status(200));"] , "type": "text/javascript" } }]
        },
        {
          "name": "Get Note by ID",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/notes/{{noteId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Single note returns 200', () => pm.response.to.have.status(200));"] , "type": "text/javascript" } }]
        },
        {
          "name": "Update Note",
          "request": { "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated Note\",\n  \"content\": \"The note has been updated successfully.\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/api/notes/{{noteId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Note update returns 200', () => pm.response.to.have.status(200));"] , "type": "text/javascript" } }]
        },
        {
          "name": "Delete Note",
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": "{{baseUrl}}/api/notes/{{noteId}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Note delete returns 200', () => pm.response.to.have.status(200));"] , "type": "text/javascript" } }]
        }
      ]
    }
  ]
}
